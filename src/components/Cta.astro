---
import site from '../data/site.json';
import { langOf, useT, link } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = useT(lang);
const { title, accent = false, href = site.calendarEmbed ? `${link(lang, '/contact/')}#appel` : site.calendar, label = t('cta.call') } = Astro.props;
---
<section class="wide">
  <div class:list={['panel', 'cta', { 'is-accent': accent }]}>
    <h2 class="cta-title">{title}</h2>
    <div class="row" style="align-items:center;gap:12px 24px">
      <a class:list={['btn', accent ? 'btn-dark' : 'btn-accent']} href={href}>{label}</a>
      <slot />
    </div>
  </div>
</section>
