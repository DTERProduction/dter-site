---
import site from '../data/site.json';
import { langOf, useT } from '../lib/i18n';
const { landing = false } = Astro.props;
const lang = langOf(Astro.url);
const t = useT(lang);
const baseline = lang === 'en' ? site.baselineEn : site.baseline;
---
<footer class="wrap site-footer">
  <span>© {site.legalName} · {landing ? t('footer.city') : `${baseline} · ${site.signature}`}</span>
  <nav aria-label={t('footer.links')}>
    {!landing && <a href={site.instagram} rel="noopener">Instagram</a>}
    {!landing && <a href={site.whatsapp} rel="noopener">WhatsApp</a>}
    <a href={site.legal} hreflang="fr">{t('footer.terms')}</a>
    <a href={site.privacy} hreflang="fr">{t('footer.privacy')}</a>
  </nav>
</footer>
