---
import site from '../data/site.json';
import mark from './logo-mark.svg?raw';
import ModeSwitch from './ModeSwitch.astro';
import { langOf, useT, link, counterpart } from '../lib/i18n';
const { landing = false, alt = true } = Astro.props;
const lang = langOf(Astro.url);
const t = useT(lang);
const L = (p: string) => link(lang, p);
const other = counterpart(Astro.url.pathname);
// Pour savoir où l'on se trouve, on raisonne sur l'adresse française de la page, quelle que soit la langue affichée.
const path = other.fr;
const cur = (p: string) => (path.startsWith(p) ? 'page' : undefined);
// Univers photo : la galerie et la page de tarifs photo. Le menu y change pour ne proposer que ce qui concerne la photo.
const photoMode = path.startsWith('/photo/') || path.startsWith('/services/photographie-corporate/');
// Sélecteur de langue : mène à la même page dans l'autre langue, ou à l'accueil quand la page n'existe qu'en français.
const toFr = alt ? other.fr : lang === 'fr' ? Astro.url.pathname : '/';
const toEn = alt ? other.en : '/en/';
---
<header class="site-header">
  {landing
    ? <span class="logo"><span class="logo-mark" set:html={mark} /><span class="sr-only">{site.name}</span></span>
    : <div class="brand"><a class="logo" href={L('/')} aria-label={t('nav.home')}><span class="logo-mark" set:html={mark} /><span class="sr-only">{site.name}</span></a><ModeSwitch /></div>}
  {landing ? (
    <div class="nav">
      <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
      <a class="btn btn-dark" href="#devis">{t('nav.getQuote')}</a>
    </div>
  ) : (
    <nav class="nav" aria-label={photoMode ? t('nav.photo') : t('nav.main')}>
      {photoMode ? (
        <>
          <a href={L('/photo/')} aria-current={cur('/photo/')}>{t('nav.gallery')}</a>
          <a href={L('/services/photographie-corporate/')} aria-current={cur('/services/photographie-corporate/')}>{t('nav.pricing')}</a>
        </>
      ) : (
        <>
          <a href={L('/realisations/')} aria-current={cur('/realisations/')}>{t('nav.projects')}</a>
          <a href={`${L('/')}#services`} aria-current={cur('/services/')}>{t('nav.services')}</a>
          <a class="nav-opt" href={`${L('/')}#methode`}>{t('nav.method')}</a>
          <a class="nav-opt" href={`${L('/')}#faq`}>{t('nav.faq')}</a>
        </>
      )}
      <span class="lang-switch mono" role="group" aria-label={t('nav.lang')}>
        <a href={toFr} hreflang="fr" lang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
        <a href={toEn} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </span>
      <a class="btn btn-dark" href={L('/contact/')}>{t('nav.quote')}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu-mobile" data-open={t('nav.menu')} data-close={t('nav.close')} aria-label={t('nav.menu')}>
        <span class="burger-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </nav>
  )}
</header>
