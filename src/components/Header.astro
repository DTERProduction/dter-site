---
import site from '../data/site.json';
import mark from './logo-mark.svg?raw';
import ModeSwitch from './ModeSwitch.astro';
const { landing = false } = Astro.props;
const path = Astro.url.pathname;
const cur = (p: string) => (path.startsWith(p) ? 'page' : undefined);
---
<header class="site-header">
  {landing
    ? <span class="logo"><span class="logo-mark" set:html={mark} /><span class="sr-only">{site.name}</span></span>
    : <div class="brand"><a class="logo" href="/" aria-label="DTER, accueil"><span class="logo-mark" set:html={mark} /><span class="sr-only">{site.name}</span></a><ModeSwitch /></div>}
  {landing ? (
    <div class="nav">
      <a href={`tel:${site.phoneHref}`}>{site.phone}</a>
      <a class="btn btn-dark" href="#devis">Recevoir un devis</a>
    </div>
  ) : (
    <nav class="nav" aria-label="Navigation principale">
      <a href="/realisations/" aria-current={cur('/realisations/')}>Projets</a>
      <a href="/#services" aria-current={cur('/services/')}>Services</a>
      <a class="nav-opt" href="/#methode">Méthode</a>
      <a class="nav-opt" href="/#faq">FAQ</a>
      <a class="btn btn-dark" href="/contact/">Demander un devis</a>
    </nav>
  )}
</header>
