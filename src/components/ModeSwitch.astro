---
import { getPhotoSeries } from '../lib/site';
import { langOf, useT, link, counterpart } from '../lib/i18n';
interface Props { videoHref?: string; }
const lang = langOf(Astro.url);
const t = useT(lang);
const { videoHref = '/' } = Astro.props;
const frPath = counterpart(Astro.url.pathname).fr;
const hasPhotos = (await getPhotoSeries()).length > 0;
const onPhoto = frPath.startsWith('/photo/') || frPath.startsWith('/services/photographie-corporate/');
---
{hasPhotos && (
  <div class="mode-switch" role="group" aria-label={t('switch.label')}>
    <a href={link(lang, videoHref)} aria-current={!onPhoto ? 'true' : undefined}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4l13 8-13 8z"></path></svg>
      <span>{t('switch.video')}</span>
    </a>
    <a href={link(lang, '/photo/')} aria-current={onPhoto ? 'true' : undefined}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="3"></rect><circle cx="12" cy="13" r="3.5"></circle><path d="M8 6l1.5-2.5h5L16 6"></path></svg>
      <span>{t('switch.photo')}</span>
    </a>
  </div>
)}
