---
interface Props { name: string; title: string; dateLabel?: string; messageLabel?: string; full?: boolean; onDark?: boolean; submit?: string; }
const { name, title, dateLabel = 'Échéance souhaitée', messageLabel = 'Votre projet en quelques lignes', full = false, onDark = false, submit = 'Envoyer ma demande' } = Astro.props;
---
<form id="devis" class:list={['form', { 'on-dark': onDark }]} name={name} method="POST" action={`/merci/?demande=${name}`} data-netlify="true" netlify-honeypot="site-web" aria-label={title}>
  <input type="hidden" name="form-name" value={name} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="hidden" name="source" data-utm="utm_source" />
  <input type="hidden" name="support" data-utm="utm_medium" />
  <input type="hidden" name="campagne" data-utm="utm_campaign" />
  <input type="hidden" name="annonce" data-utm="utm_content" />
  <input type="hidden" name="mot-cle" data-utm="utm_term" />
  <input type="hidden" name="clic-google" data-utm="gclid" />
  <input type="hidden" name="clic-meta" data-utm="fbclid" />
  <p hidden><label>Ne pas remplir <input name="site-web" tabindex="-1" autocomplete="off" /></label></p>
  <span class="form-title">{title}</span>
  {onDark && <small>Gratuit et sans engagement.</small>}
  <div class="fields">
    <label class="field">Nom et prénom<input type="text" name="nom" autocomplete="name" required /></label>
    <label class="field">Société<input type="text" name="societe" autocomplete="organization" /></label>
  </div>
  <div class="fields">
    <label class="field">Email professionnel<input type="email" name="email" autocomplete="email" required /></label>
    {full && <label class="field">Téléphone<input type="tel" name="telephone" autocomplete="tel" /></label>}
  </div>
  {full && (
    <label class="field">Type de projet
      <select name="type">
        <option>Vidéo corporate</option>
        <option>Aftermovie, événement</option>
        <option>Brand content, réseaux sociaux</option>
        <option>Photographie</option>
        <option>Post-production seule</option>
        <option>Autre</option>
      </select>
    </label>
  )}
  <label class="field">{dateLabel}<input type="date" name="date" /></label>
  <label class="field">{messageLabel}<textarea name="message" rows={full ? 4 : 3}></textarea></label>
  <button class:list={['btn', onDark ? 'btn-accent' : 'btn-dark']} type="submit">{submit}</button>
  <small>{onDark ? 'Réponse de Thomas, fondateur de DTER, en personne. ' : ''}Vos données servent uniquement à vous répondre. <a href="/politique-de-confidentialite/" style="text-decoration:underline">Politique de confidentialité</a></small>
</form>

<script>
  // Provenance de la visite : lue dans l'adresse de la page, sans cookie, et jointe à la demande.
  const params = new URLSearchParams(location.search);
  document.querySelectorAll<HTMLInputElement>('input[data-utm]').forEach((i) => { i.value = params.get(i.dataset.utm || '') || ''; });
</script>
