---
interface Props { name: string; title: string; dateLabel?: string; messageLabel?: string; full?: boolean; onDark?: boolean; submit?: string; }
import site from '../data/site.json';
import { langOf, useT, link } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = useT(lang);
const { name, title, dateLabel = t('form.deadline'), messageLabel = t('form.message'), full = false, onDark = false, submit = t('form.send') } = Astro.props;
// Avec une clé Web3Forms, la demande part par email. Sans clé, on garde les formulaires Netlify.
const key = (site as { formKey?: string }).formKey;
const thanks = `${link(lang, '/merci/')}?demande=${name}`;
---
<form id="devis" class:list={['form', { 'on-dark': onDark }]} name={name} method="POST" action={key ? 'https://api.web3forms.com/submit' : thanks} data-netlify={key ? undefined : 'true'} netlify-honeypot={key ? undefined : 'site-web'} aria-label={title}>
  {key ? (
    <>
      <input type="hidden" name="access_key" value={key} />
      <input type="hidden" name="redirect" value={new URL(thanks, Astro.site).href} />
      <input type="hidden" name="from_name" value="Site DTER" />
      <input type="hidden" name="subject" value={`${t('form.subject')} · ${name}${lang === 'en' ? ' · EN' : ''}`} data-subject />
      <input type="checkbox" name="botcheck" hidden tabindex="-1" autocomplete="off" />
    </>
  ) : <input type="hidden" name="form-name" value={name} />}
  <input type="hidden" name="formulaire" value={name} />
  <input type="hidden" name="langue" value={lang === 'en' ? 'anglais' : 'français'} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="hidden" name="source" data-utm="utm_source" />
  <input type="hidden" name="support" data-utm="utm_medium" />
  <input type="hidden" name="campagne" data-utm="utm_campaign" />
  <input type="hidden" name="annonce" data-utm="utm_content" />
  <input type="hidden" name="mot-cle" data-utm="utm_term" />
  <input type="hidden" name="clic-google" data-utm="gclid" />
  <input type="hidden" name="clic-meta" data-utm="fbclid" />
  <p hidden><label>Ne pas remplir <input name="site-web" tabindex="-1" autocomplete="off" /></label></p>
  <span class="form-title">{title}</span>
  {onDark && <small>{t('form.free')}</small>}
  <div class="fields">
    <label class="field">{t('form.name')}<input type="text" name="nom" autocomplete="name" required /></label>
    <label class="field">{t('form.company')}<input type="text" name="societe" autocomplete="organization" /></label>
  </div>
  <div class="fields">
    <label class="field">{t('form.email')}<input type="email" name="email" autocomplete="email" required /></label>
    {full && <label class="field">{t('form.phone')}<input type="tel" name="telephone" autocomplete="tel" /></label>}
  </div>
  {full && (
    <label class="field">{t('form.type')}
      <select name="type">
        <option>{t('form.t1')}</option>
        <option>{t('form.t2')}</option>
        <option>{t('form.t3')}</option>
        <option>{t('form.t4')}</option>
        <option>{t('form.t5')}</option>
        <option>{t('form.t6')}</option>
      </select>
    </label>
  )}
  <label class="field">{dateLabel}<input type="date" name="date" /></label>
  <label class="field">{messageLabel}<textarea name="message" rows={full ? 4 : 3}></textarea></label>
  <button class:list={['btn', onDark ? 'btn-accent' : 'btn-dark']} type="submit">{submit}</button>
  <small>{onDark ? t('form.personal') : ''}{t('form.data')} <a href="/politique-de-confidentialite/" hreflang="fr" style="text-decoration:underline">{t('form.policy')}</a></small>
</form>

<script>
  // Provenance de la visite : lue dans l'adresse de la page, sans cookie, et jointe à la demande.
  const params = new URLSearchParams(location.search);
  document.querySelectorAll<HTMLInputElement>('input[data-utm]').forEach((i) => { i.value = params.get(i.dataset.utm || '') || ''; });
  // L'objet du mail indique la provenance, pour trier les demandes d'un coup d'œil.
  const src = [params.get('utm_source'), params.get('utm_campaign')].filter(Boolean).join(' / ');
  if (src) document.querySelectorAll<HTMLInputElement>('input[data-subject]').forEach((i) => { i.value += ` · ${src}`; });
</script>
