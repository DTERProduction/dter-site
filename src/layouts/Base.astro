---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import mark from '../components/logo-mark.svg?raw';
import { langOf, useT, link, loc, counterpart } from '../lib/i18n';


interface Props { title: string; description?: string; landing?: boolean; noindex?: boolean; image?: string; dark?: boolean; jsonld?: Record<string, unknown>; alt?: boolean; }
const lang = langOf(Astro.url);
const t = useT(lang);
const L = (p: string) => link(lang, p);
// alt : la page existe dans l'autre langue. Faux pour les pages légales, rédigées en français uniquement.
const { title, description = lang === 'en' ? site.baselineEn : site.baseline, landing = false, noindex = false, image, dark = false, jsonld, alt = true } = Astro.props;
const other = counterpart(Astro.url.pathname);
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site);
const origin = new URL('/', Astro.site).href;
// Carte d'identité de l'entreprise, lue par les moteurs de recherche et les assistants IA.
const business = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${origin}#entreprise`,
  name: 'DTER Production',
  legalName: site.legalName,
  description: `${lang === 'en' ? site.baselineEn : site.baseline}. ${t('biz.desc')}`,
  url: origin,
  email: site.email,
  telephone: site.phone,
  vatID: 'BE1043250440',
  founder: { '@type': 'Person', name: 'Thomas Dubois' },
  address: { '@type': 'PostalAddress', streetAddress: 'Zuidlaan 14', postalCode: '1560', addressLocality: 'Hoeilaart', addressCountry: 'BE' },
  areaServed: [{ '@type': 'City', name: lang === 'en' ? 'Brussels' : 'Bruxelles' }, { '@type': 'Country', name: lang === 'en' ? 'Belgium' : 'Belgique' }],
  knowsLanguage: ['fr', 'en'],
  sameAs: [site.instagram, 'https://vimeo.com/user196867759'],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && alt && <link rel="alternate" hreflang="fr" href={abs(other.fr)} />}
    {!noindex && alt && <link rel="alternate" hreflang="en" href={abs(other.en)} />}
    {!noindex && alt && <link rel="alternate" hreflang="x-default" href={abs(other.fr)} />}
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'fr_BE'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content={dark ? '#141413' : '#f8f7f3'} />
    {!landing && <script type="application/ld+json" set:html={JSON.stringify(business)} />}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script is:inline>
      // Masque les éléments animés avant leur entrée. Filet de sécurité : tout réapparaît si le script d'animation ne démarre pas.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion', 'pt-enter');
        setTimeout(function () { if (!window.__motion) document.documentElement.classList.remove('js-motion'); }, 4000);
      }
    </script>
  </head>
  <body class={dark ? 'theme-dark' : undefined}>
    <div class="curtain" aria-hidden="true">
      <span class="curtain-bar is-top"></span>
      <span class="curtain-bar is-bottom"></span>
      <div class="curtain-mid">
        <span class="logo-mark" set:html={mark} />
        <span class="mono curtain-tc"><span class="accent">●</span> <span data-tc>00:00:00:00</span></span>
      </div>
    </div>
    <div class="site-header-wrap"><Header landing={landing} alt={alt} /></div>
    {!landing && <MobileMenu alt={alt} />}
    <main><slot /></main>
    <Footer landing={landing} />
    <script>
      import '../scripts/motion.ts';
      (window as any).__motion = true;
    </script>
    <script>
      // Lecture Vimeo au clic : aucune requête vers Vimeo avant que le visiteur ne le demande.
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-vimeo]') as HTMLElement | null;
        if (!btn) return;
        const box = btn.closest('.media');
        if (!box) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://player.vimeo.com/video/${btn.dataset.vimeo}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = btn.getAttribute('aria-label') || 'Vidéo';
        box.replaceChildren(iframe);
      });
    </script>
  </body>
</html>
