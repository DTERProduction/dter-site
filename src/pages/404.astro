---
import Base from '../layouts/Base.astro';
import { langOf, useT, link, loc } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = useT(lang);
const L = (p: string) => link(lang, p);

---
<Base title={t('404.seoTitle')} noindex>
  <section class="wrap section stack" style="gap:24px;min-height:50vh">
    <span class="eyebrow">{t('404.eyebrow')}</span>
    <h1 class="display">{t('404.title')}</h1>
    <a class="btn btn-dark" style="align-self:flex-start" href={L('/')}>{t('404.cta')}</a>
  </section>
</Base>
