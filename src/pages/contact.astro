---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import site from '../data/site.json';
import { langOf, useT, link, loc } from '../lib/i18n';
const lang = langOf(Astro.url);
const t = useT(lang);
const L = (p: string) => link(lang, p);

const rows = [
  ['Email', site.email, `mailto:${site.email}`],
  [t('contact.phone'), site.phone, `tel:${site.phoneHref}`],
  ['WhatsApp', t('contact.whatsapp'), site.whatsapp],
  [t('contact.call'), t('home.slot'), site.calendarEmbed ? '#appel' : site.calendar],
];
---
<Base title={t('contact.seoTitle')} description={t('contact.seoDesc')}>
  <section class="wrap section split" style="gap:48px 64px;align-items:flex-start">
    <div class="stack" style="flex:999 1 420px;min-width:0;gap:24px">
      <span class="eyebrow">Contact</span>
      <h1 class="display">{t('contact.title')}</h1>
      <p class="lead" style="max-width:520px">{t('contact.lead')}</p>
      <div class="contact-rows">
        {rows.map(([k, v, h]) => <a href={h}><span class="mono">{k}</span><strong>{v}</strong></a>)}
        <a><span class="mono">Studio</span><strong>{t('contact.place')}</strong></a>
      </div>
    </div>
    <div style="flex:1 1 420px;min-width:0"><QuoteForm name="contact" title={t('contact.formTitle')} full /></div>
  </section>

  {site.calendarEmbed && (
    <section class="wide" id="appel">
      <div class="panel booking">
        <div class="booking-side">
          <span class="eyebrow">{t('book.eyebrow')}</span>
          <h2 class="booking-title">{t('book.title')}</h2>
          <ul class="booking-points">
            <li><span class="mono">01</span>{t('book.p1')}</li>
            <li><span class="mono">02</span>{t('book.p2')}</li>
            <li><span class="mono">03</span>{t('book.p3')}</li>
          </ul>
          <p class="booking-note">{t('book.note')}</p>
        </div>
        <div class="booking-frame" data-booking={site.calendarEmbed} data-title={t('book.frame')}>
          <div class="booking-bar mono"><i></i><i></i><i></i><span>{t('book.agenda')}</span></div>
          <div class="booking-body">
            <div class="booking-grid" aria-hidden="true">{Array.from({ length: 28 }).map((_, i) => <i style={`--i:${i}`}></i>)}</div>
            <div class="booking-cta">
              <button class="btn btn-accent" type="button" data-booking-open>{t('book.show')}</button>
              <a class="booking-alt" href={site.calendar} target="_blank" rel="noopener">{t('book.newTab')}</a>
              <small>{t('book.google')}</small>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <script>
    const frame = document.querySelector<HTMLElement>('[data-booking]');
    const open = () => {
      if (!frame || frame.classList.contains('is-open')) return;
      const body = frame.querySelector('.booking-body')!;
      const f = document.createElement('iframe');
      f.src = frame.dataset.booking!;
      f.title = frame.dataset.title || '';
      f.loading = 'lazy';
      frame.classList.add('is-loading');
      f.addEventListener('load', () => { frame.classList.remove('is-loading'); frame.classList.add('is-open'); });
      body.appendChild(f);
    };
    frame?.querySelector('[data-booking-open]')?.addEventListener('click', open);
  </script>
</Base>
