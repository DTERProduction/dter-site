---
import { getCollection } from 'astro:content';
import Page from '../../lp/[slug].astro';
import { landingEn } from '../../../lib/i18n';

export async function getStaticPaths() {
  const landings = await getCollection('landings');
  return landings.map((l) => ({ params: { slug: landingEn[l.id] || l.id }, props: { landing: l } }));
}
---
<Page {...Astro.props} />
