---
import portrait from '../assets/thomas-dubois.jpg';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Faq from '../components/Faq.astro';
import PhotoBand from '../components/PhotoBand.astro';
import { Image, getImage } from 'astro:assets';
import site from '../data/site.json';
import home from '../data/home.json';
import clients from '../data/clients.json';
import testimonials from '../data/testimonials.json';
import { getProjects, getServices, getPhotoSeries, categories, catLabel } from '../lib/site';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const thumbOf = (vimeoId?: string) => projects.find((p) => p.data.vimeoId === vimeoId)?.data.thumb;
const trail = projects.map((p) => p.data.thumb).filter(Boolean).slice(0, 8);
// Aperçus au survol des services : une image pour la vidéo, un jeu de cartes pour la photo, une table de montage pour la post-production.
const allPhotos = (await getPhotoSeries()).flatMap((x) => x.data.photos);
const pickedPhotos = (allPhotos.filter((x) => x.featured).length >= 4 ? allPhotos.filter((x) => x.featured) : allPhotos).slice(0, 5);
const photoCards = await Promise.all(pickedPhotos.map(async (x) => (await getImage({ src: x.image, width: 640, format: 'webp' })).src));
const clipThumbs = projects.map((p) => p.data.thumb).filter(Boolean).slice(0, 5);
const preview = (id: string, vimeoId?: string) => {
  if (id === 'photographie-corporate' && photoCards.length) return { kind: 'photos', images: photoCards };
  if (id === 'post-production' && clipThumbs.length) return { kind: 'timeline', images: clipThumbs };
  const t = thumbOf(vimeoId);
  return t ? { kind: 'video', images: [t] } : null;
};
// Bandeau clients : dès que six clients ont un logo, on n'affiche que ceux-là. Les autres restent dans la liste, prêts à recevoir le leur.
const withLogo = clients.items.filter((c) => c.logo);
const shownClients = withLogo.length >= 6 ? withLogo : clients.items;
const services = await getServices();
const [mainQuote, ...quotes] = testimonials.items;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={home.seoTitle} description={home.seoDescription} image={home.heroPoster}>
  <section class="wrap intro">
    <p class="wordmark" aria-hidden="true"><span>DTER</span><span>Production</span></p>
    <div class="intro-meta mono">
      <h1 class="dot">{home.h1}</h1>
      <span class="mut2">Défiler ↓</span>
    </div>
  </section>

  <section class="hero-wrap" data-hero-wrap>
    <div class="hero-sticky">
      <div class="hero-window" data-hero={home.heroVimeoId}>
        {home.heroPoster && <img src={home.heroPoster} alt="" fetchpriority="high" />}
      </div>
      <div class="hero-over">
        <p class="hero-line">{home.heroLines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>
        <a class="hero-card" href={site.calendarEmbed ? '/contact/#appel' : site.calendar}>
          <span class="avatar"><Image src={portrait} alt="Thomas Dubois" width={144} height={144} loading="eager" /><i class="avatar-dot" aria-hidden="true"></i></span>
          <span class="hero-card-text"><strong class="swap"><span>Parler à Thomas</span><span aria-hidden="true">Choisir un créneau</span></strong><small>Fondateur de DTER · appel de 20 min</small></span>
          <span class="hero-card-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section stack" aria-label="Clients" style="padding-bottom:0">
    <div class="wrap head"><span class="eyebrow">Marques</span><h2 class="h2">{home.clientsTitle}</h2></div>
    <div class="marquee">
      <div class="marquee-track">
        {[...shownClients, ...shownClients].map((c, i) => (
          <span class:list={['marquee-item', { 'has-logo': c.logo }]} aria-hidden={i >= shownClients.length ? 'true' : undefined}>
            {c.logo ? <img src={c.logo} alt={c.name} loading="lazy" decoding="async" /> : c.name}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section stack">
    <div class="head"><span class="eyebrow">Pourquoi DTER</span><h2 class="h2">{home.whyTitle}</h2></div>
    <div class="cards">
      {home.promises.map((p, i) => (
        <div class:list={['card', { 'is-dark': i === home.promises.length - 1 }]}>
          <span class="num">{pad(i + 1)}</span>
          <h3 class="h3">{p.title}</h3>
          <p class="mut">{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="projets" class="wrap section-b stack">
    <div class="between">
      <h2 class="h-xl">{home.projectsTitle}<span class="accent">.</span></h2>
      <a class="btn btn-dark" href="/realisations/">Tous les projets</a>
    </div>
    <div class="stack-cards">
      {featured.map((p, i) => (
        <a class="stack-card" style={`--i:${i}`} href={`/realisations/${p.id}/`}>
          <div class="stack-inner">
            <div class="stack-meta"><strong>{p.data.client} · {p.data.title}</strong><span class="mono mut2">{catLabel(p.data.categories)}</span></div>
            <div class="media">{p.data.thumb && <img src={p.data.thumb} alt="" loading="lazy" decoding="async" />}</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <PhotoBand />

  <section class="wide" aria-label="Témoignages">
    <div class="panel stack" style="gap:48px">
      <span class="eyebrow">Témoignages</span>
      <figure class="stack" style="gap:22px">
        <blockquote class="quote-lg">« {mainQuote.quote} »</blockquote>
        <figcaption class="quote-by"><strong>{mainQuote.name}</strong> · {mainQuote.role}</figcaption>
      </figure>
      <div class="quotes">
        {quotes.map((q) => (
          <figure>
            <blockquote>« {q.quote} »</blockquote>
            <figcaption class="quote-by"><strong>{q.name}</strong> · {q.role}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="wrap section stack">
    <div class="row" style="align-items:baseline;gap:12px 20px">
      <h2 class="h-xl">Services</h2><span class="mono mut2">({pad(services.length)})</span>
    </div>
    <div class="rows">
      {services.map((s, i) => (
        <a href={`/services/${s.id}/`} data-kind={preview(s.id, s.data.vimeoId)?.kind} data-images={JSON.stringify(preview(s.id, s.data.vimeoId)?.images || [])}>
          <span class="idx">{i + 1}</span>
          <h3 class="name">{s.data.name}</h3>
          <span class="desc">
            <span>{s.data.short}</span>
            <span class="chips">{s.data.tags.map((t) => <span>{t}</span>)}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section id="methode" class="wrap section-b stack">
    <div class="head"><span class="eyebrow">Méthode</span><h2 class="h2">{home.methodTitle}</h2></div>
    <div class="steps">
      {home.method.map((m, i) => (
        <div>
          <span class="mono">00:{pad(i + 1)} · {m.label}</span>
          <span class="h3">{m.title}</span>
          <span class="mut">{m.text}</span>
        </div>
      ))}
    </div>
  </section>

  <section id="studio" class="wrap section-b split" style="align-items:center">
    <div class="reel-col">
      {home.studioVimeoId ? (
        <div class="reel" data-reel={home.studioVimeoId}>
          {home.studioPoster && <img src={home.studioPoster} alt="Coulisses d'un tournage DTER" loading="lazy" decoding="async" />}
          <div class="reel-frame"></div>
          <button class="reel-btn" type="button" aria-label={`${home.studioVideoLabel}, avec le son`}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4l13 8-13 8z"></path></svg>
            <span>{home.studioVideoLabel}</span>
          </button>
        </div>
      ) : (
        <div class="media r-4-5">
          {home.studioImage && <img src={home.studioImage} alt="Thomas Dubois sur un tournage" loading="lazy" />}
        </div>
      )}
    </div>
    <div class="stack" style="flex:999 1 420px;min-width:0;gap:22px">
      <span class="eyebrow">Le studio</span>
      <h2 class="h2">{home.studioTitle}</h2>
      <p class="lead" style="max-width:620px">{home.studioText}</p>
      <a class="link" style="align-self:flex-start" href="/contact/">Faire connaissance →</a>
    </div>
  </section>

  <section id="faq" class="wrap section-b split">
    <div class="side"><span class="eyebrow">FAQ</span><h2 class="h2">{home.faqTitle}</h2></div>
    <div class="main"><Faq items={home.faq} /></div>
  </section>

  <section class="wide">
    <div class="panel cta" data-trail={JSON.stringify(trail)}>
      <span class="mono trail-hint">Bougez la souris</span>
      <h2 class="cta-title" style="font-size:clamp(44px,7.4vw,120px);flex-basis:100%">{home.ctaTitle}</h2>
      <div class="row" style="align-items:center;gap:12px 28px">
        <a class="btn btn-accent" href={site.calendarEmbed ? '/contact/#appel' : site.calendar}>Réserver un appel</a>
        <a class="link" style="font-weight:500" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>

  <script>
    // Coulisses : la boucle muette démarre quand la section arrive à l'écran, le bouton relance la vidéo avec le son.
    const reel = document.querySelector<HTMLElement>('[data-reel]');
    if (reel) {
      const frame = reel.querySelector<HTMLElement>('.reel-frame')!;
      const btn = reel.querySelector<HTMLButtonElement>('.reel-btn')!;
      const id = reel.dataset.reel;
      const quiet = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData;
      const mount = (src: string, title: string, interactive: boolean) => {
        const f = document.createElement('iframe');
        f.src = src;
        f.allow = 'autoplay; fullscreen; picture-in-picture';
        f.title = title;
        if (!interactive) { f.setAttribute('aria-hidden', 'true'); f.tabIndex = -1; }
        frame.classList.toggle('is-live', interactive);
        frame.replaceChildren(f);
      };
      if (!quiet) {
        const io = new IntersectionObserver((entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          if (!frame.classList.contains('is-live')) mount(`https://player.vimeo.com/video/${id}?background=1&autoplay=1&muted=1&loop=1&dnt=1`, 'Coulisses DTER', false);
        }, { rootMargin: '200px' });
        io.observe(reel);
      }
      btn.addEventListener('click', () => {
        mount(`https://player.vimeo.com/video/${id}?autoplay=1&loop=1&dnt=1&title=0&byline=0&portrait=0`, 'Coulisses DTER, avec le son', true);
        btn.hidden = true;
      });
    }

    // Vidéo de fond du hero : chargée après l'affichage de la page, jamais si l'utilisateur limite les animations ou les données.
    const bg = document.querySelector<HTMLElement>('.hero-window[data-hero]');
    const conn = (navigator as any).connection;
    const ok = bg?.dataset.hero && !matchMedia('(prefers-reduced-motion: reduce)').matches && !conn?.saveData;
    if (bg && ok) {
      window.addEventListener('load', () => {
        const f = document.createElement('iframe');
        f.src = `https://player.vimeo.com/video/${bg.dataset.hero}?background=1&autoplay=1&muted=1&loop=1&dnt=1`;
        f.allow = 'autoplay';
        f.title = 'Showreel DTER';
        f.setAttribute('aria-hidden', 'true');
        f.tabIndex = -1;
        bg.appendChild(f);
      });
    }
  </script>
</Base>
