---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Vimeo from '../../components/Vimeo.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import site from '../../data/site.json';
import clientData from '../../data/clients.json';
import testimonials from '../../data/testimonials.json';
import { getProjects, catLabel } from '../../lib/site';
import { langOf, useT, loc } from '../../lib/i18n';


export async function getStaticPaths() {
  const landings = await getCollection('landings');
  return landings.map((l) => ({ params: { slug: l.id }, props: { landing: l } }));
}
const { landing } = Astro.props;
const lang = langOf(Astro.url);
const t = useT(lang);
const l = loc(landing.data, lang);
// Deux mises en page : « corporate » (formulaire à côté du titre, plan du film en fond) et « event » (formats verticaux, formulaire en barre).
const isEvent = l.layout === 'event';
const submit = l.submitLabel || t('form.getMine');
const all = await getProjects();
const examples = l.examples.map((id) => all.find((p) => p.id === id)).filter(Boolean);
// Film d'en-tête : le projet choisi s'il est en ligne, sinon la vidéo de secours.
const heroProject = l.heroProject ? all.find((p) => p.id === l.heroProject) : undefined;
const heroId = heroProject?.data.vimeoId || l.vimeoId;
const poster = heroProject?.data.thumb || all.find((p) => p.data.vimeoId === l.vimeoId)?.data.thumb;
// Formats verticaux de la landing événement : seuls les projets en ligne avec une image.
const reels = (landing.data.reels || [])
  .map((r, i) => ({ label: (l.reels?.[i] as any)?.label || r.label, p: all.find((p) => p.id === r.project) }))
  .filter((r) => r.p && r.p.data.thumb);
// Fond animé de la landing corporate : une boucle muette (le showreel par défaut), sinon l'image du film.
const loopId = l.loopVimeoId;
const bgImage = l.loopPoster || poster;
// Film ouvert au clic sur l'en-tête : la boucle de fond en version complète si elle existe, sinon le film du projet.
const filmId = loopId || heroId;
const filmLabel = l.watchLabel || (heroProject ? `${t('lp.watch')} ${heroProject.data.client}` : t('lp.watch'));
// Seuls les clients dont le logo officiel est dans clients.json s'affichent (« L'Oréal Professionnel » prend celui de « L'Oréal »).
const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
const known = (clientData as any).items.filter((c: any) => c.logo);
const logos = l.clients
  .map((name) => ({ name, logo: known.find((c: any) => norm(name).startsWith(norm(c.name)))?.logo as string | undefined }))
  .filter((c) => c.logo);
const pad = (n: number) => String(n).padStart(2, '0');
// Autres retours, choisis par leur nom dans testimonials.json (avis Google compris).
const reviews = (landing.data.reviews || [])
  .map((n) => (testimonials.items as any[]).find((q) => q.name === n))
  .filter(Boolean)
  .map((q: any) => (lang === 'en' ? { ...q, quote: q.quoteEn || q.quote, role: q.roleEn || q.role } : q));
// Badge de note Google, affiché seulement si la note est renseignée.
const g = site as { googleRating?: string; googleReviews?: number; googleProfile?: string };
const googleLine = g.googleRating ? `★ ${lang === 'en' ? g.googleRating.replace(',', '.') : g.googleRating} ${t('lp.google')}${g.googleReviews ? ` · ${g.googleReviews} ${t('lp.reviews')}` : ''}` : '';
---
<Base title={l.seoTitle} description={l.lead} landing noindex>
  <section class="wide">
    <div class:list={['lp-a', { 'is-event': isEvent }]} data-film-zone={!isEvent && filmId ? filmId : undefined} data-film-label={filmLabel}>
      {!isEvent && bgImage && <img class="lp-a-bg" src={bgImage} alt="" decoding="async" fetchpriority="high" />}
      {!isEvent && loopId && <div class="lp-a-loop" data-loop={loopId} data-loop-title={filmLabel}></div>}
      <div class="lp-a-body">
        <div class="lp-a-text">
          <span class="eyebrow">{l.eyebrow}</span>
          <h1 class="lp-title">{l.title}</h1>
          <p class="lp-a-lead">{l.lead}</p>
          {!isEvent && filmId && (
            <button class="btn lp-watch" type="button" data-film={filmId} data-film-label={filmLabel}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4l13 8-13 8z"></path></svg>
              {filmLabel}
            </button>
          )}
        </div>
        {isEvent ? (
          reels.length > 0 && (
            <div class="lp-reels">
              {reels.map(({ p, label }) => (
                <button class="lp-reel" type="button" data-film={p!.data.vimeoId} data-film-zone={p!.data.vimeoId} data-film-label={`${label} · ${p!.data.client}`} aria-label={`${t('lp.watch')} : ${label}, ${p!.data.client}`}>
                  <span class:list={['lp-reel-img', { 'is-vertical': p!.data.vertical }]}>
                    <img src={p!.data.thumb} alt="" loading="lazy" decoding="async" />
                    <span class="lp-reel-loop" data-loop={p!.data.vimeoId} data-loop-title={label}></span>
                    <span class="lp-reel-tag">{label}</span>
                  </span>
                  <span class="mono">{p!.data.client}</span>
                </button>
              ))}
            </div>
          )
        ) : (
          <QuoteForm name={`lp-${landing.id}`} title={l.formTitle} note={l.priceNote} dateLabel={l.dateLabel} messageLabel={l.messageLabel} onDark company={false} message={false} dateOptional submit={submit} />
        )}
      </div>
      {isEvent && (
        <div class="lp-a-bar">
          <QuoteForm name={`lp-${landing.id}`} title={l.formTitle} note={l.priceNote} dateLabel={l.dateLabel} messageLabel={l.messageLabel} onDark company={false} message={false} bar submit={submit} />
        </div>
      )}
      {(l.proof || googleLine || logos.length > 0) && (
        <div class="lp-proof">
          {(l.proof || googleLine) && (
            <span class="lp-proof-text">
              {l.proof && <span class="mono">{l.proof}</span>}
              {googleLine && (g.googleProfile ? <a class="mono lp-google" href={g.googleProfile} target="_blank" rel="noopener">{googleLine}</a> : <span class="mono lp-google">{googleLine}</span>)}
            </span>
          )}
          {logos.length > 0 && <span class="lp-logos" role="list" aria-label={l.clientsLabel}>{logos.map((c) => <img role="listitem" src={c.logo} alt={c.name} loading="lazy" />)}</span>}
        </div>
      )}
    </div>
  </section>

  {l.deliverables.length > 0 && (
    <section class="wrap lp-sec stack">
      {l.deliverEyebrow && <span class="eyebrow">{l.deliverEyebrow}</span>}
      <h2 class="h2" style="max-width:860px">{l.deliverTitle}</h2>
      <div class:list={['cards', { 'is-big-num': isEvent }]}>
        {l.deliverables.map((d, i) => (
          <div class:list={['card', { 'is-dark': !isEvent && i === l.deliverables.length - 1 }]}><span class="num">{pad(i + 1)}</span><h3 class="h3">{d.title}</h3><p class="mut">{d.text}</p></div>
        ))}
      </div>
    </section>
  )}

  {(() => {
    const quote = l.quote && (
      <section class="wide lp-sec" aria-label={t('lp.feedback')}>
        <figure class:list={['panel', 'stack', 'lp-quote', { 'is-accent': isEvent }]}>
          <span class="eyebrow">{t('lp.feedback')}</span>
          <blockquote class="quote-lg">« {l.quote} »</blockquote>
          {l.quoteFrom && <figcaption class="quote-by"><strong>{l.quoteFrom}</strong></figcaption>}
          {reviews.length > 0 && (
            <div class="quotes">
              {reviews.map((q) => (
                <figure>
                  <blockquote>« {q.quote} »</blockquote>
                  <figcaption class="quote-by"><strong>{q.name}</strong> · {q.role}</figcaption>
                </figure>
              ))}
            </div>
          )}
        </figure>
      </section>
    );
    const steps = l.steps.length > 0 && (
      <section class="wrap lp-sec stack">
        {l.stepsEyebrow && <span class="eyebrow">{l.stepsEyebrow}</span>}
        {l.stepsTitle && <h2 class="h2">{l.stepsTitle}</h2>}
        <div class="steps">
          {l.steps.map((s) => (
            <div><span class="mono">{s.label}</span><h3 class="h3">{s.title}</h3><p class="mut">{s.text}</p></div>
          ))}
        </div>
      </section>
    );
    return isEvent ? <>{steps}{quote}</> : <>{quote}{steps}</>;
  })()}

  {examples.length > 0 && (
    <section class="wrap lp-sec stack" style="gap:28px" aria-label={t('lp.work')}>
      <span class="eyebrow">{t('lp.work')}</span>
      <h2 class="h2">{l.examplesTitle}</h2>
      <div class="projects">
        {examples.map((p) => (
          <div class="project">
            <Vimeo id={p.data.vimeoId} thumb={p.data.thumb} label={`${p.data.client}, ${p.data.title}`} ratio="" small />
            <div class="project-meta"><span class="project-title">{p.data.client} · {loc(p.data, lang).title}</span><span class="mono mut2">{catLabel(p.data.categories, lang)}</span></div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="wrap lp-sec stack" style="gap:28px">
    <h2 class="h2">{l.faqTitle}</h2>
    <div style="max-width:880px"><Faq items={l.faq} /></div>
  </section>

  <div class="lp-sec">
    <Cta title={l.ctaTitle} accent={!isEvent} href="#devis" label={submit}>
      <a style="font-weight:600;font-size:19px;padding:12px 0" href={`tel:${site.phoneHref}`}>{t('lp.or')} {site.phone}</a>
    </Cta>
  </div>

  <dialog class="film" data-film-dialog aria-label={t('lp.watch')}>
    <button class="film-close" type="button" data-film-close aria-label={t('lp.close')}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
    <div class="media r-16-9" data-film-box></div>
  </dialog>
</Base>

<script>
  // Film en grand au clic : rien n'est demandé à Vimeo avant que le visiteur ne le décide.
  const dialog = document.querySelector<HTMLDialogElement>('[data-film-dialog]');
  const box = dialog?.querySelector<HTMLElement>('[data-film-box]');
  document.querySelectorAll<HTMLElement>('[data-film]').forEach((b) => {
    b.addEventListener('click', () => {
      if (!dialog || !box) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://player.vimeo.com/video/${b.dataset.film}?autoplay=1&dnt=1&title=0&byline=0&portrait=0`;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = b.dataset.filmLabel || 'Vidéo';
      box.replaceChildren(iframe);
      dialog.showModal();
    });
  });
  dialog?.querySelector('[data-film-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => box?.replaceChildren());

  // En-tête corporate : un clic hors du formulaire et du bandeau de logos ouvre le film.
  const zone = document.querySelector<HTMLElement>('.lp-a[data-film-zone]');
  zone?.addEventListener('click', (e) => {
    const el = e.target as HTMLElement;
    if (el.closest('form, a, button, input, .lp-proof')) return;
    zone.querySelector<HTMLElement>('.lp-watch')?.click();
  });

  // Boucles muettes (fond corporate, formats verticaux) : chargées quand elles arrivent à l'écran,
  // jamais si le visiteur limite les animations ou les données. Le son vient au clic, dans la fenêtre du film.
  const quiet = matchMedia('(prefers-reduced-motion: reduce)').matches || (navigator as any).connection?.saveData;
  const loops = Array.from(document.querySelectorAll<HTMLElement>('[data-loop]'));
  if (!quiet && loops.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const el = en.target as HTMLElement;
        io.unobserve(el);
        const f = document.createElement('iframe');
        f.src = `https://player.vimeo.com/video/${el.dataset.loop}?background=1&autoplay=1&muted=1&loop=1&dnt=1`;
        f.allow = 'autoplay';
        f.title = el.dataset.loopTitle || 'Vidéo';
        f.setAttribute('aria-hidden', 'true');
        f.tabIndex = -1;
        f.addEventListener('load', () => el.classList.add('is-live'));
        el.appendChild(f);
      });
    }, { rootMargin: '200px' });
    // Après le chargement de la page, pour ne pas ralentir l'affichage ; tout de suite si la page est déjà chargée.
    const start = () => loops.forEach((el) => io.observe(el));
    if (document.readyState === 'complete') start(); else window.addEventListener('load', start, { once: true });
  }
</script>
