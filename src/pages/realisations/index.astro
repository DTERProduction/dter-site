---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Cta from '../../components/Cta.astro';
import ModeSwitch from '../../components/ModeSwitch.astro';
import { getProjects, categories, catName } from '../../lib/site';
import { langOf, useT, link, loc } from '../../lib/i18n';
const lang = langOf(Astro.url);
const t = useT(lang);
const L = (p: string) => link(lang, p);

const projects = await getProjects();
const used = Object.keys(categories).filter((k) => projects.some((p) => p.data.categories.includes(k as never)));
---
<Base title={t('work.seoTitle')} description={t('work.seoDesc')}>
  <section class="wrap section stack" style="gap:28px;padding-bottom:40px">
    <div class="row" style="align-items:center;gap:12px 20px"><span class="eyebrow">{t('work.eyebrow')}</span><ModeSwitch videoHref="/realisations/" /></div>
    <div class="row" style="align-items:baseline;gap:8px 20px">
      <h1 class="display">{t('work.title')}</h1>
      <span class="mono mut2" style="font-size:17px">(<span data-count>{projects.length}</span>)</span>
    </div>
    <p class="lead" style="max-width:620px">{t('work.lead')}</p>
    <div class="filters" role="group" aria-label={t('work.filter')}>
      <button class="filter" type="button" data-filter="all" aria-pressed="true">{t('work.all')}</button>
      {used.map((k) => <button class="filter" type="button" data-filter={k} aria-pressed="false">{catName(k, lang)}</button>)}
    </div>
  </section>
  <section class="wrap section-b" aria-label={t('work.list')}>
    <div class="projects">{projects.map((p) => <ProjectCard project={p} />)}</div>
  </section>
  <Cta title={t('work.cta')} />
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.project[data-cat]');
    const count = document.querySelector('[data-count]');
    buttons.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter;
      let n = 0;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cards.forEach((c) => { const show = f === 'all' || (c.dataset.cat || '').split(' ').includes(f!); c.hidden = !show; if (show) n++; });
      if (count) count.textContent = String(n);
      // Les cartes changent de place : on prévient les animations pour qu'elles affichent tout de suite celles qui restent.
      window.dispatchEvent(new CustomEvent('dter:filter'));
    }));
  </script>
</Base>
